# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (leave blank to run in local static-data mode) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (test mode keys; leave blank to use the demo payment path in development) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI (server-only) ----
ANTHROPIC_API_KEY=
# Model used by the concierge and merchant employees.
AI_MODEL=claude-opus-5-5

# ---- Commerce ----
# "live": Stripe Checkout only. "demo": allows the simulated payment path outside production.
COMMERCE_MODE=demo

# ---- Rehearsal + admin (v0.2) ----
# "1" lets `/city?clock=` and the clock-offset header shift the city clock on a production build
# (staging only: it changes which products are purchasable). Always on outside production.
ALLOW_CLOCK_OVERRIDE=0
# Required to open /admin/generate (merchant generator) in production; ≥16 chars. Open on localhost.
ADMIN_ACCESS_TOKEN=
# Namespace for presence rooms when several deployments share one Supabase project.
PRESENCE_ROOM_PREFIX=city

# ---- Media (v0.2) ----
# Prefix for relative image paths in the data (CDN origin). Absolute URLs pass through untouched.
NEXT_PUBLIC_IMAGE_CDN_BASE=
# Optional optimizer URL template with {url}, {width}, {height}, {quality} placeholders.
NEXT_PUBLIC_IMAGE_OPTIMIZER_TEMPLATE=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (leave blank to run in local static-data mode) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (test mode keys; leave blank to use the demo payment path in development) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI (server-only) ----
ANTHROPIC_API_KEY=
# Model used by the concierge and merchant employees.
AI_MODEL=claude-opus-5-5

# ---- Commerce ----
# "live": Stripe Checkout only. "demo": allows the simulated payment path outside production.
COMMERCE_MODE=demo
